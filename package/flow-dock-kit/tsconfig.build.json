{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "main.ts",
    "types.ts",
    "generator/**/*.ts",
    "templates/**/*.ts",
    "utils/**/*.ts"
  ]
}
