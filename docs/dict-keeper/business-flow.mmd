flowchart TD
    Start([进入 Dict Keeper])
    HasPreset{"是否已有可用数据源预设？"}
    UsePreset["使用已有数据源预设"]
    Start --> HasPreset
    HasPreset -- 是 --> UsePreset

    subgraph FirstAccess["首次接入"]
        AccessChoice{"如何获得预设？"}
        ChoosePreset["选择现成数据源预设"]
        ImportPreset["导入预设配置"]
        ReviewPreset["确认预设配置"]
        SavePreset["保存为本地预设"]
        EnablePreset["启用数据源预设"]

        AccessChoice -- 现成预设 --> ChoosePreset --> ReviewPreset
        AccessChoice -- 导入配置 --> ImportPreset --> ReviewPreset
        ReviewPreset --> SavePreset --> EnablePreset
    end

    HasPreset -- 否 --> AccessChoice

    subgraph DailyUse["日常使用"]
        SelectDict["选择或搜索数据字典"]
        ViewDict["查看字典详情和字典项"]
        WorkChoice{"当前要执行什么操作？"}
        CrudAction["新增 / 编辑 / 删除字典或字典项"]
        BatchImport["批量导入字典项到当前字典"]
        RefreshResult["刷新列表并显示最新结果"]
        ContinueChoice{"是否继续处理？"}
        Finish([完成])

        SelectDict --> ViewDict --> WorkChoice
        WorkChoice -- 仅查看 --> ContinueChoice
        WorkChoice -- 新增 / 编辑 / 删除 --> CrudAction --> RefreshResult --> ContinueChoice
        WorkChoice -- 批量导入 --> BatchImport --> RefreshResult
        ContinueChoice -- 继续处理当前字典 --> ViewDict
        ContinueChoice -- 切换其他字典 --> SelectDict
        ContinueChoice -- 结束 --> Finish
    end

    UsePreset --> SelectDict
    EnablePreset --> SelectDict