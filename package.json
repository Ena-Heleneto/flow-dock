{
  "name": "ena-workspace-kit-extension",
  "displayName": "Ena Workspace Kit Extension",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "[description]",
  "scripts": {
    "dev": "./.bin/dev.sh",
    "build": "./.bin/build.sh",
    "pack": "./.bin/pack.sh",
    "start": "./.bin/start.sh",
    "start:chrome": "./.bin/start.sh chrome",
    "start:firefox": "./.bin/start.sh firefox",
    "clear": "./.bin/clear.sh",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "simple-git-hooks",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@ffflorian/jszip-cli": "catalog:",
    "@iconify/json": "catalog:",
    "@playwright/test": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "@types/webextension-polyfill": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@unocss/reset": "catalog:",
    "@vitejs/devtools": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueuse/core": "catalog:",
    "chokidar": "catalog:",
    "consola": "catalog:",
    "cross-env": "catalog:",
    "crx": "catalog:",
    "defu": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "esno": "catalog:",
    "fs-extra": "catalog:",
    "jsdom": "catalog:",
    "kolorist": "catalog:",
    "lint-staged": "catalog:",
    "npm-run-all": "catalog:",
    "rimraf": "catalog:",
    "sass-embedded": "catalog:",
    "simple-git-hooks": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-scrollbar": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-inspect": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-demi": "catalog:",
    "web-ext": "catalog:",
    "webext-bridge": "catalog:",
    "webextension-polyfill": "catalog:",
    "xlsx": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
