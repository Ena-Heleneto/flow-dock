{
  "name": "ena-workspace-kit-extension",
  "displayName": "Ena Workspace Kit Extension",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "[description]",
  "scripts": {
    "dev": "./.bin/dev.sh",
    "build": "./.bin/build.sh",
    "pack": "./.bin/pack.sh",
    "start": "./.bin/start.sh",
    "start:chrome": "./.bin/start.sh chrome",
    "start:firefox": "./.bin/start.sh firefox",
    "clear": "./.bin/clear.sh",
    "lint": "eslint --cache .",
    "test": "vitest test",
    "test:e2e": "playwright test",
    "postinstall": "simple-git-hooks",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.1.0",
    "@ffflorian/jszip-cli": "^3.8.5",
    "@iconify/json": "^2.2.460",
    "@playwright/test": "^1.46.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.5.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@unocss/reset": "^0.62.2",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/compiler-sfc": "^3.4.38",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^11.0.1",
    "chokidar": "^3.6.0",
    "consola": "^3.4.2",
    "cross-env": "^7.0.3",
    "crx": "^5.0.1",
    "eslint": "^10.2.0",
    "esno": "^4.7.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^24.1.1",
    "kolorist": "^1.8.0",
    "lint-staged": "^15.2.9",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "sass-embedded": "^1.99.0",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^6.0.2",
    "unocss": "^66.6.7",
    "unocss-preset-scrollbar": "^4.0.0",
    "unplugin-auto-import": "^0.18.2",
    "unplugin-icons": "^0.19.2",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^8.0.7",
    "vitest": "^2.0.5",
    "vue": "^3.5.32",
    "vue-demi": "^0.14.10",
    "web-ext": "^8.2.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
