{
  "name": "ena-work-tool",
  "displayName": "Ena Work Tool",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "description": "[description]",
  "scripts": {
    "dev": "bash ./.bin/dev.sh",
    "unpacked": "bash ./.bin/unpacked-build-artifact.sh",
    "release": "bash ./.bin/release-build-artifact.sh",
    "start:chromium": "bash ./.bin/start.sh dev chrome",
    "start:firefox": "bash ./.bin/start.sh dev firefox",
    "clear": "rimraf --glob dist pack extension/dist extension/manifest.json extension.*",
    "_prepare": "esno scripts/prepare.ts",
    "_dev:web": "cross-env NODE_ENV=development APP_ENV=development vite",
    "_dev:chrome": "cross-env NODE_ENV=development APP_ENV=development EXTENSION_DIR=dist/dev/chrome pnpm run _dev:single",
    "_dev:firefox": "cross-env NODE_ENV=development APP_ENV=development EXTENSION=firefox EXTENSION_DIR=dist/dev/firefox pnpm run _dev:single",
    "_dev:single": "cross-env NPM_CONFIG_LOGLEVEL=error run-p --npm-path pnpm _prepare _build:serve:dev _build:js:dev",
    "_build:single": "cross-env NPM_CONFIG_LOGLEVEL=error run-s --npm-path pnpm _prepare _build:web _build:serve _build:js",
    "_build:web": "vite build",
    "_build:serve": "vite build --config vite.config.serve.mts",
    "_build:js": "vite build --config vite.config.content.mts",
    "_build:serve:dev": "vite build --config vite.config.serve.mts --mode development",
    "_build:js:dev": "vite build --config vite.config.content.mts --mode development",
    "lint": "eslint --cache .",
    "test": "vitest test",
    "test:e2e": "playwright test",
    "postinstall": "simple-git-hooks",
    "typecheck": "tsc --noEmit"
  },

  "devDependencies": {
    "@antfu/eslint-config": "^2.27.0",
    "@ffflorian/jszip-cli": "^3.8.5",
    "@iconify/json": "^2.2.444",
    "@playwright/test": "^1.46.1",
    "@techstark/opencv-js": "4.12.0-release.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.5.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@unocss/reset": "^0.62.2",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/compiler-sfc": "^3.4.38",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^11.0.1",
    "chokidar": "^3.6.0",
    "consola": "^3.4.2",
    "cross-env": "^7.0.3",
    "crx": "^5.0.1",
    "eslint": "^9.9.0",
    "esno": "^4.7.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^24.1.1",
    "kolorist": "^1.8.0",
    "lint-staged": "^15.2.9",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.5.4",
    "unocss": "^66.6.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vitest": "^2.0.5",
    "vue": "^3.5.29",
    "vue-demi": "^0.14.10",
    "web-ext": "^8.2.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
